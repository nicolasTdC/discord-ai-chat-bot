DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# One or more numeric user IDs copied from Discord, separated by commas.
ALLOWED_USER_IDS=
OWNER_USER_ID=
GEMINI_API_KEY=
# Leave blank to use the official SDK's current Flash alias.
GEMINI_MODEL=gemini-flash-latest
# Initial/fallback interval; always clamped to the bounds below.
SCAN_INTERVAL_SECONDS=30
MIN_SCAN_INTERVAL_SECONDS=10
MAX_SCAN_INTERVAL_SECONDS=120
# Every launch starts paused; the owner must DM resume to enable automatic replies.

# Maximum generated responses per scan; earlier messages remain context, not backlog.
MAX_RESPONSES_PER_SCAN=1
SKIP_LOW_CONTENT_MESSAGES=true

# Optional private prompt path; relative to the repository root or absolute.
SYSTEM_PROMPT_PATH=

# Independent feedback prompt; relative to the repository root or absolute.
# For a private custom prompt, use e.g. private_data/feedback_prompt.txt.
FEEDBACK_PROMPT_PATH=feedback_prompt.txt
